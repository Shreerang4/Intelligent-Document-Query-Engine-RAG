# Application database and API configuration
DATABASE_URL=sqlite:///./rag_persistence.db
GROQ_API_KEY=
ACCESS_JWT_SECRET=
API_TOKEN=

# Private source-document object storage. Current API routes do not write to
# this storage yet; these settings prepare the storage-only foundation.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=./uploads/object-storage

# S3-compatible settings (used when OBJECT_STORAGE_BACKEND=s3). Leave explicit
# credentials empty to use boto3's IAM/workload/shared-config provider chain.
OBJECT_STORAGE_S3_ENDPOINT_URL=
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
OBJECT_STORAGE_S3_SESSION_TOKEN=
OBJECT_STORAGE_S3_ADDRESSING_STYLE=auto
