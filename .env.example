# Copy to the ignored .env and fill secrets privately. Blank secret values are
# placeholders, not working credentials. See docs/deployment.md for all settings.
# SQLite is a host-local fallback only. Compose API/worker need the SAME reachable
# MySQL database; compose.yaml does not share this SQLite file or provision MySQL.
DATABASE_URL=sqlite:///./rag_persistence.db
DB_CA_CERT=
DB_CA_CERT_B64=
GROQ_API_KEY=
ACCESS_JWT_SECRET=
# Optional: protects /health/db only, not application user routes.
API_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=600
# Set false only for plain-HTTP localhost development; keep true in production.
REFRESH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=
# Keep 7860 for HF/Compose. Host Vite development proxies to PORT=8000 instead.
PORT=7860

# Private source-document object storage. Async API publishers and workers must
# share this configuration; for local storage they must share the same volume.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=./uploads/object-storage

# Active production source storage uses Backblaze B2 through backend=s3.
# Supply private bucket/endpoint/region and application credentials externally.
# S3-compatible settings (used when OBJECT_STORAGE_BACKEND=s3). Leave explicit
# credentials empty to use boto3's IAM/workload/shared-config provider chain.
OBJECT_STORAGE_S3_ENDPOINT_URL=
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
OBJECT_STORAGE_S3_SESSION_TOKEN=
OBJECT_STORAGE_S3_ADDRESSING_STYLE=auto

# RabbitMQ/Celery task delivery. The default URL is suitable for running the
# worker against a default host RabbitMQ. Production supplies an external broker
# secret to BOTH API and worker. Compose overrides with COMPOSE_CELERY_BROKER_URL.
# For a host worker against the Compose broker, use its local idqe credentials.
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
DOCUMENT_INGESTION_QUEUE=document_ingestion
# Three Celery retries after the initial attempt; worker-loss redeliveries are
# separate and are not capped by this counter.
DOCUMENT_INGESTION_MAX_RETRIES=3
DOCUMENT_INGESTION_RETRY_BACKOFF_SECONDS=5
DOCUMENT_INGESTION_RETRY_BACKOFF_MAX_SECONDS=300

# Local Compose-only RabbitMQ settings. URL-encode special characters if using
# custom credentials in COMPOSE_CELERY_BROKER_URL. These are development examples,
# never production credentials; keep the user/password and URL in agreement.
RABBITMQ_DEFAULT_USER=idqe
RABBITMQ_DEFAULT_PASS=idqe-local
COMPOSE_CELERY_BROKER_URL=amqp://idqe:idqe-local@rabbitmq:5672//

# Retrieval defaults. Keep worker/query embedding model settings compatible.
MAX_PDF_BYTES=15728640
HTTP_TIMEOUT_SECONDS=30
EMBEDDING_MODEL_NAME=intfloat/e5-small-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
LLM_MODEL_NAME=openai/gpt-oss-20b
RETRIEVAL_MODE=faiss_reranker
RETRIEVAL_K_INITIAL=20
RETRIEVAL_K_FINAL=8
# Only used by the experimental e5_bm25_reranker branch.
HYBRID_E5_K_INITIAL=30
HYBRID_BM25_K_INITIAL=20
HYBRID_K_FINAL=5
# Per-request parallel-question limit, not Celery or global HTTP concurrency.
MAX_CONCURRENT_QUESTIONS=4
DOCUMENT_CACHE_MAX_ITEMS=8
DOCUMENT_CACHE_TTL_SECONDS=3600
# allow_duplicate/upload_request_id are multipart API fields, not env settings.
